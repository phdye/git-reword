#!/usr/bin/env python3
#
# git-reword - change the message of a commit that is already written.
#
# Rewording is not editing.  A message is part of the object that names the
# commit, so changing it mints a new commit, and every commit standing on that
# one has to be minted again.  That is the whole cost, and the decisions here
# follow from paying it once and being able to see what it bought.
#
# The rewrite is a replay, not a rebase.  Each commit is read as a raw object,
# its parents remapped, its message replaced where one was given, and the
# result written back.  Nothing is re-applied and nothing is re-merged, so
# there is no conflict to resolve and no merge resolution to lose -- a rebase
# re-creates a merge by performing it again, and a merge somebody resolved by
# hand does not survive that.  Trees are reused by id, so a reworded commit
# holds byte-identical content to the one it replaces, and the author, the
# author date, the committer and the committer date are copied rather than
# taken fresh.  Only the message and the commit ids change.
#
# Rewording one commit moves every local branch and tag standing on it, not
# only the one that happens to be checked out.  Moving a subset is how a
# repository ends up holding both spellings of the same history, each on its
# own ref, with nothing to say which is meant.  So the affected refs are found
# first, named in the plan, and moved together.
#
# Two things it refuses rather than does.  A commit somebody else wrote is not
# reworded, because taking over another author's commit is worse than leaving
# a message badly worded.  A commit a remote-tracking branch already holds is
# not reworded either, because publishing that rewrite takes a force push, and
# that is the operator's call rather than a tool's.  Each has a flag, and
# neither flag pushes anything.
#
# Every ref it moves is copied under refs/reword-backup/<stamp>/ before the
# move, and the command that puts each one back is printed.

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

PROG = "git-reword"
VERSION = "1.0.0"

E_OK = 0
E_FAIL = 1
E_USAGE = 2
E_REPO = 3
E_WORKTREE = 4
E_AUTHOR = 5
E_PUBLISHED = 6
E_TAG = 7

